# Copy to .env and edit. Never commit .env.
HOMELAB_ROOT=/srv/homelab

# Host timezone
TZ=Europe/Berlin

# Zigbee coordinator: find with `ls -l /dev/serial/by-id/`
ZIGBEE_DEVICE=/dev/serial/by-id/REPLACE_WITH_YOUR_COORDINATOR

# Container UID/GID for Syncthing. Check with `id`.
PUID=1000
PGID=1000

# Development database. Replace before starting development project.
POSTGRES_USER=homelab
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=homelab

# Optional: external backup mount point
BACKUP_MOUNT=/mnt/homelab-backup
